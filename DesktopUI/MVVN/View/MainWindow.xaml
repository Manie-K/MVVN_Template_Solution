<Window x:Class="DesktopUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopUI"
        xmlns:view="clr-namespace:DesktopUI.MVVN.View"
        xmlns:viewmodel="clr-namespace:DesktopUI.MVVN.Viewmodel"
        mc:Ignorable="d"
        Background="#30303F"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodel:SettingsViewModel}">
            <view:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button Content="Settings" Command="{Binding NavigateToSettingsCommand}" 
                HorizontalAlignment="Left" 
                Margin="10,10,0,0" 
                Grid.Column="0"
                VerticalAlignment="Top" 
                Width="75" 
                Height="25"/>

        <ContentControl Content="{Binding Navigation.CurrentViewModel}"
                        Grid.Column="1">
            
        </ContentControl>
    </Grid>
</Window>
